//
// Native Pre-Match & Post-Match Press Conference V2 Menu (Free-Text Answer + NO COMMENT)
//

#include "common.mh"

Menu pressConferenceMenu
{
    onInit: initPressConferenceMenu
    onDraw: drawPressConferenceMenu
    initialEntry: answerBtn

    Entry header {
        x: 24
        y: 0
        width: 256
        height: 13

        color: kHeaderColor
        text: @kAlloc
    }

    Entry answerBtn {
        x: 8
        y: 176
        width: 150
        height: 16

        color: @kGreen
        text: @kAlloc
        rightEntry: noCommentBtn
        onSelect: submitOrContinuePressConference
    }

    Entry noCommentBtn {
        x: 164
        y: 176
        width: 132
        height: 16

        color: @kRed
        text: @kAlloc
        leftEntry: answerBtn
        onSelect: noCommentPressConference
    }
}
