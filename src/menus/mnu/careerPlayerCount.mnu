//
// Career Player Count Selection Menu
//

#include "common.mh"

Menu careerPlayerCountMenu
{
    initialEntry: twoPlayers
    onInit: ~onInitPlayerCountMenu

    kMenuWidth = 140
    kMenuHeight = 15
    kMenuX = 85
    kStartY = 46
    kStepperBtnWidth = 18
    kStepperCenterWidth = kMenuWidth - 2 * kStepperBtnWidth - 2

    Entry header {
        x: 60
        y: 18
        width: 190
        height: 16

        color: @kDarkBlue
        textFlags: @kBigText | @kCenterAligned
        text: "NUMBER OF PLAYERS"
    }

    Entry onePlayer {
        x: kMenuX
        y: kStartY
        width: kMenuWidth
        height: kMenuHeight

        color: @kLightBrownWithOrangeFrame
        downEntry: twoPlayers

        textFlags: @kBigText | @kCenterAligned
        text: "1 PLAYER"
        onSelect: ~onSelect1Player
    }

    Entry twoPlayers {
        x: kMenuX
        y: @prevEndY + 5
        width: kMenuWidth
        height: kMenuHeight

        color: @kLightBrownWithOrangeFrame
        upEntry: onePlayer
        downEntry: threePlayers

        textFlags: @kBigText | @kCenterAligned
        text: "2 PLAYERS"
        onSelect: ~onSelect2Players
    }

    Entry threePlayers {
        x: kMenuX
        y: @prevEndY + 5
        width: kMenuWidth
        height: kMenuHeight

        color: @kLightBrownWithOrangeFrame
        upEntry: twoPlayers
        downEntry: fourPlayers

        textFlags: @kBigText | @kCenterAligned
        text: "3 PLAYERS"
        onSelect: ~onSelect3Players
    }

    Entry fourPlayers {
        x: kMenuX
        y: @prevEndY + 5
        width: kMenuWidth
        height: kMenuHeight

        color: @kLightBrownWithOrangeFrame
        upEntry: threePlayers
        downEntry: customPlayers

        textFlags: @kBigText | @kCenterAligned
        text: "4 PLAYERS"
        onSelect: ~onSelect4Players
    }

    Entry decreasePlayers {
        x: kMenuX
        y: @prevEndY + 6
        width: kStepperBtnWidth
        height: kMenuHeight

        color: @kDarkBlue
        upEntry: fourPlayers
        rightEntry: customPlayers
        downEntry: exitButton

        textFlags: @kBigText | @kCenterAligned
        text: "-"
        onSelect: ~onDecreaseCustomPlayers
    }

    Entry customPlayers {
        x: @prevEndX + 1
        y: @prevY
        width: kStepperCenterWidth
        height: kMenuHeight

        color: @kLightBrownWithOrangeFrame
        upEntry: fourPlayers
        leftEntry: decreasePlayers
        rightEntry: increasePlayers
        downEntry: exitButton

        textFlags: @kBigText | @kCenterAligned
        text: "5 PLAYERS"
        onSelect: ~onSelectCustomPlayers
    }

    Entry increasePlayers {
        x: @prevEndX + 1
        y: @prevY
        width: kStepperBtnWidth
        height: kMenuHeight

        color: @kDarkBlue
        upEntry: fourPlayers
        leftEntry: customPlayers
        downEntry: exitButton

        textFlags: @kBigText | @kCenterAligned
        text: "+"
        onSelect: ~onIncreaseCustomPlayers
    }

    Entry exitButton {
        x: kMenuX
        y: @prevEndY + 10
        width: kMenuWidth
        height: kMenuHeight

        color: @kRed
        upEntry: customPlayers

        textFlags: @kBigText | @kCenterAligned
        text: "EXIT"
        onSelect: ~onSelectExitPlayerCount
    }
}
