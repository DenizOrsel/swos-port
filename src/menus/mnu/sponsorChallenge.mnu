//
// Pre-match Sponsor Challenge V2 multi-select menu (5 offers + Multi-Match Contract slot)
//

#include "common.mh"

Menu sponsorChallengeMenu
{
    onInit: initSponsorChallengeMenu
    onDraw: drawSponsorChallengeMenu
    initialEntry: challenge1

    Entry header {
        x: 34
        y: 0
        width: 236
        height: 12

        color: kHeaderColor
        text: "SPONSOR MATCH CHALLENGES"
    }

    Entry challenge1 {
        x: 8
        y: 31
        width: 288
        height: 13

        color: @kDarkBlue
        text: @kAlloc
        downEntry: challenge2
        onSelect: toggleSponsorChallenge1
    }

    Entry challenge2 {
        x: 8
        y: 58
        width: 288
        height: 13

        color: @kDarkBlue
        text: @kAlloc
        upEntry: challenge1
        downEntry: challenge3
        onSelect: toggleSponsorChallenge2
    }

    Entry challenge3 {
        x: 8
        y: 85
        width: 288
        height: 13

        color: @kDarkBlue
        text: @kAlloc
        upEntry: challenge2
        downEntry: challenge4
        onSelect: toggleSponsorChallenge3
    }

    Entry challenge4 {
        x: 8
        y: 112
        width: 288
        height: 13

        color: @kDarkBlue
        text: @kAlloc
        upEntry: challenge3
        downEntry: challenge5
        onSelect: toggleSponsorChallenge4
    }

    Entry challenge5 {
        x: 8
        y: 139
        width: 288
        height: 13

        color: @kDarkBlue
        text: @kAlloc
        upEntry: challenge4
        downEntry: confirmBtn
        onSelect: toggleSponsorChallenge5
    }

    Entry confirmBtn {
        x: 8
        y: 169
        width: 184
        height: 16

        color: @kGreen
        text: @kAlloc
        upEntry: challenge5
        rightEntry: declineBtn
        onSelect: confirmSponsorChallenges
    }

    Entry declineBtn {
        x: 198
        y: 169
        width: 98
        height: 16

        color: kExitColor
        text: "DECLINE ALL"
        upEntry: challenge5
        leftEntry: confirmBtn
        onSelect: declineSponsorChallenges
    }
}
