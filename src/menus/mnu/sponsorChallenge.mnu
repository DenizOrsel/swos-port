//
// Pre-match Sponsor Challenge multi-select menu
//

#include "common.mh"

Menu sponsorChallengeMenu
{
    onInit: initSponsorChallengeMenu
    onDraw: drawSponsorChallengeMenu
    initialEntry: challenge1

    Entry header {
        x: 34
        y: 0
        width: 236
        height: 14

        color: kHeaderColor
        text: "SPONSOR MATCH CHALLENGES"
    }

    Entry challenge1 {
        x: 8
        y: 38
        width: 288
        height: 16

        color: @kDarkBlue
        text: @kAlloc
        downEntry: challenge2
        onSelect: toggleSponsorChallenge1
    }

    Entry challenge2 {
        x: 8
        y: 84
        width: 288
        height: 16

        color: @kDarkBlue
        text: @kAlloc
        upEntry: challenge1
        downEntry: challenge3
        onSelect: toggleSponsorChallenge2
    }

    Entry challenge3 {
        x: 8
        y: 130
        width: 288
        height: 16

        color: @kDarkBlue
        text: @kAlloc
        upEntry: challenge2
        downEntry: confirmBtn
        onSelect: toggleSponsorChallenge3
    }

    Entry confirmBtn {
        x: 8
        y: 178
        width: 176
        height: 17

        color: @kGreen
        text: @kAlloc
        upEntry: challenge3
        rightEntry: declineBtn
        onSelect: confirmSponsorChallenges
    }

    Entry declineBtn {
        x: 192
        y: 178
        width: 104
        height: 17

        color: kExitColor
        text: "DECLINE ALL"
        upEntry: challenge3
        leftEntry: confirmBtn
        onSelect: declineSponsorChallenges
    }
}
